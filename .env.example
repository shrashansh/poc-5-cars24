# Copy to .env and fill in. Without a key the app runs on the rule-based extractor and template replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=8000
# Key for the advisor console and dialer endpoints. Change it outside a demo.
ADVISOR_KEY=advisor-demo
# RATE_LIMIT_PER_MIN=20
# LLM_TIMEOUT_MS=15000
